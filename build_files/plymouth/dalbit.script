// Dalbit OS 부팅 화면
// 완전한 검정 위로 실버 마크가 살짝 떠오르며 나타나고, 별만 천천히 숨 쉬듯 반짝임.
// 아래에 dalbit 글자와 1px 진행 막대.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = Window.GetX() + sw / 2;
cy = Window.GetY() + sh / 2;

// 초승달과 별은 같은 크기의 캔버스라 같은 위치에 겹치면 로고가 됨
cres_img = Image("crescent.png");
star_img = Image("star.png");
mark_w = cres_img.GetWidth();
mark_h = cres_img.GetHeight();
mark_x = cx - mark_w / 2;
mark_y = cy - mark_h / 2 - 40;

cres = Sprite(cres_img);
cres.SetX(mark_x);
cres.SetY(mark_y + 8);
cres.SetZ(10);
cres.SetOpacity(0);

star = Sprite(star_img);
star.SetX(mark_x);
star.SetY(mark_y + 8);
star.SetZ(11);
star.SetOpacity(0);

title_img = Image("title.png");
title = Sprite(title_img);
title_y = mark_y + mark_h + 26;
title.SetX(cx - title_img.GetWidth() / 2);
title.SetY(title_y);
title.SetZ(10);
title.SetOpacity(0);

// 작업 중 표시: 얇은 막대 안에서 짧은 빛이 좌우로 흐름
// (Plymouth의 진행률은 이전 부팅 시간으로 추정한 값이라 실제와 맞지 않아 쓰지 않음)
bar_w = 84;
bar_h = 1;
seg_w = 26;
bar_x = cx - bar_w / 2;
bar_y = title_y + title_img.GetHeight() + 20;
bar_src = Image("bar.png");
bar_bg = Sprite(bar_src.Scale(bar_w, bar_h));
bar_bg.SetX(bar_x);
bar_bg.SetY(bar_y);
bar_bg.SetZ(10);
bar_bg.SetOpacity(0);
bar_fg = Sprite();
bar_fg.SetY(bar_y);
bar_fg.SetZ(11);
bar_fg.SetOpacity(0);

global.t = 0;
fun refresh_callback() {
    global.t = global.t + 1;
    // 약 1.5초 동안 나타남 (50fps 기준)
    a = global.t / 75;
    if (a > 1) {
        a = 1;
    }
    // 부드럽게 감속 (ease-out)
    e = 1 - (1 - a) * (1 - a);
    y = mark_y + 8 * (1 - e);
    cres.SetY(y);
    star.SetY(y);
    cres.SetOpacity(e);
    // 별: 나타난 뒤 3초 주기로 천천히 밝아졌다 어두워짐
    s = Math.Cos(global.t * 0.04);
    star.SetOpacity(e * (0.775 + 0.225 * s));
    title.SetOpacity(e * 0.9);
    bar_bg.SetOpacity(e * 0.15);

    // 흐르는 빛: 약 1.8초 주기, 양 끝에서 천천히 (ease-in-out), 막대 밖으로는 잘라서 그림
    cycles = global.t / 90;
    phase = cycles - Math.Int(cycles);
    k = 0.5 - 0.5 * Math.Cos(3.14159 * phase);
    head = bar_x - seg_w + (bar_w + seg_w) * k;
    left = head;
    if (left < bar_x) {
        left = bar_x;
    }
    right = head + seg_w;
    if (right > bar_x + bar_w) {
        right = bar_x + bar_w;
    }
    w = Math.Int(right - left);
    if (w >= 1) {
        bar_fg.SetImage(bar_src.Scale(w, bar_h));
        bar_fg.SetX(left);
        bar_fg.SetOpacity(e * 0.9);
    } else {
        bar_fg.SetOpacity(0);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// 디스크 암호 입력 (암호화를 쓰는 경우)
prompt_sprite = Sprite();
bullet_sprite = Sprite();
prompt_sprite.SetZ(20);
bullet_sprite.SetZ(20);

fun display_password_callback(prompt, bullets) {
    p = Image.Text(prompt, 0.91, 0.92, 0.93);
    prompt_sprite.SetImage(p);
    prompt_sprite.SetX(cx - p.GetWidth() / 2);
    prompt_sprite.SetY(bar_y + 30);
    prompt_sprite.SetOpacity(1);
    str = " ";
    for (i = 0; i < bullets; i++) {
        str = str + "* ";
    }
    b = Image.Text(str, 0.66, 0.72, 0.85);
    bullet_sprite.SetImage(b);
    bullet_sprite.SetX(cx - b.GetWidth() / 2);
    bullet_sprite.SetY(bar_y + 60);
    bullet_sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    prompt_sprite.SetOpacity(0);
    bullet_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// 메시지 (업데이트 진행 등)
message_sprite = Sprite();
message_sprite.SetZ(20);
fun message_callback(text) {
    m = Image.Text(text, 0.55, 0.57, 0.62);
    message_sprite.SetImage(m);
    message_sprite.SetX(cx - m.GetWidth() / 2);
    message_sprite.SetY(Window.GetY() + sh - 60);
}
Plymouth.SetMessageFunction(message_callback);
