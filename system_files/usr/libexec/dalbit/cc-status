#!/usr/bin/env bash
# Dalbit OS 컨트롤 센터 · 시작하기 위젯용 상태 (JSON 한 줄)
set -uo pipefail
shopt -s nullglob

# 모양: 현재 전역 테마
lnf=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null || true)
case "$lnf" in *light*) mode=light ;; *) mode=dark ;; esac
# 배치: Windows식(아래 작업표시줄) / 맥식(위 메뉴 막대 + 독)
case "$lnf" in *mac*) layout=mac ;; *) layout=windows ;; esac

# 전원 프로필 (tuned-ppd, KDE 배터리 위젯과 같은 시스템 기능)
prof=$(busctl get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | sed -E 's/^s "(.*)"$/\1/')
case "$prof" in power-saver) power=save ;; performance) power=perf ;; *) power=balanced ;; esac

# 배터리 보호 / 잔량
battery=$(/usr/bin/dalbit-battery raw 2>/dev/null || echo unsupported)
cap=""; bstat=""
bat=(/sys/class/power_supply/BAT*)
if [ ${#bat[@]} -gt 0 ]; then
    cap=$(cat "${bat[0]}/capacity" 2>/dev/null || true)
    bstat=$(cat "${bat[0]}/status" 2>/dev/null || true)
fi

# 휴대폰 (KDE Connect: 연결되어 있는 첫 기기의 ID · 이름 · 배터리)
phone=""; phone_id=""; phone_batt=""
line=$(kdeconnect-cli -a --id-name-only 2>/dev/null | head -n1 || true)
if [ -n "$line" ]; then
    phone_id=${line%% *}
    phone=${line#* }
    phone_batt=$(busctl --user get-property org.kde.kdeconnect "/modules/kdeconnect/devices/$phone_id/battery" \
        org.kde.kdeconnect.device.battery charge 2>/dev/null | awk '{ print $2 }' || true)
fi

# 업데이트: 다음 부팅 때 적용될 배포가 있는지
st=$(rpm-ostree status --json 2>/dev/null || echo '{}')
booted=$(jq -r '[.deployments[]? | select(.booted == true)][0].version // ""' <<<"$st")
staged=$(jq -r '[.deployments[]? | select(.staged == true)][0].version // ""' <<<"$st")
if [ -n "$staged" ]; then update=ready; else update=ok; fi

jq -cn --arg mode "$mode" --arg layout "$layout" --arg power "$power" --arg battery "$battery" \
       --arg cap "$cap" --arg bstat "$bstat" \
       --arg phone "$phone" --arg phoneId "$phone_id" --arg phoneBattery "$phone_batt" \
       --arg update "$update" --arg booted "$booted" --arg staged "$staged" \
   '{mode:$mode, layout:$layout, power:$power, battery:$battery, capacity:$cap, batteryStatus:$bstat,
     phone:$phone, phoneId:$phoneId, phoneBattery:$phoneBattery,
     update:$update, version:$booted, stagedVersion:$staged}'
