#!/usr/bin/env bash
# Dalbit OS 컨트롤 센터 "자원" 칸: CPU · 메모리 · 그래픽 · 온도 · 배터리 소모 (JSON 한 줄)
# 컨트롤 센터가 열려 있을 때만 2초마다 호출된다.
set -uo pipefail
shopt -s nullglob

# CPU 사용률: /proc/stat을 0.4초 간격으로 두 번 읽어 계산
read_cpu() { awk '/^cpu / { idle = $5 + $6; tot = 0; for (i = 2; i <= NF; i++) tot += $i; print tot, idle }' /proc/stat; }
read -r t1 i1 < <(read_cpu)
sleep 0.4
read -r t2 i2 < <(read_cpu)
dt=$(( t2 - t1 )); di=$(( i2 - i1 ))
cpu=""
(( dt > 0 )) && cpu=$(( 100 * (dt - di) / dt ))

# 메모리 (GB)
read -r mem_used mem_total < <(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 }
    END { printf "%.1f %.1f\n", (t - a) / 1048576, t / 1048576 }' /proc/meminfo)

# 내장 그래픽 사용률 (amdgpu)
gpu=""
for f in /sys/class/drm/card*/device/gpu_busy_percent; do gpu=$(cat "$f" 2>/dev/null); break; done

# CPU 온도 (Ryzen: k10temp Tctl)
temp=""
for h in /sys/class/hwmon/hwmon*; do
    if [ "$(cat "$h/name" 2>/dev/null)" = k10temp ] && [ -r "$h/temp1_input" ]; then
        temp=$(( $(cat "$h/temp1_input") / 1000 )); break
    fi
done

# 배터리 소모 전력(W)과 남은 시간(분)
power=""; minutes=""; bstat=""
bat=(/sys/class/power_supply/BAT*)
if (( ${#bat[@]} )); then
    b=${bat[0]}
    bstat=$(cat "$b/status" 2>/dev/null || true)
    pw=0
    if [ -r "$b/power_now" ]; then
        pw=$(cat "$b/power_now")
    elif [ -r "$b/current_now" ] && [ -r "$b/voltage_now" ]; then
        pw=$(( $(cat "$b/current_now") / 1000 * $(cat "$b/voltage_now") / 1000 ))
    fi
    if [ -r "$b/energy_now" ]; then
        en=$(cat "$b/energy_now"); ef=$(cat "$b/energy_full")
    elif [ -r "$b/charge_now" ] && [ -r "$b/voltage_now" ]; then
        v=$(cat "$b/voltage_now")
        en=$(( $(cat "$b/charge_now") / 1000 * v / 1000 )); ef=$(( $(cat "$b/charge_full") / 1000 * v / 1000 ))
    else
        en=0; ef=0
    fi
    if (( pw > 0 )); then
        power=$(awk -v p="$pw" 'BEGIN { printf "%.1f", p / 1000000 }')
        if [ "$bstat" = Discharging ]; then
            minutes=$(( en * 60 / pw ))
        elif [ "$bstat" = Charging ] && (( ef > en )); then
            minutes=$(( (ef - en) * 60 / pw ))
        fi
    fi
fi

jq -cn --arg cpu "$cpu" --arg mu "$mem_used" --arg mt "$mem_total" --arg gpu "$gpu" \
       --arg temp "$temp" --arg power "$power" --arg minutes "$minutes" --arg bstat "$bstat" \
   '{cpu:$cpu, memUsed:$mu, memTotal:$mt, gpu:$gpu, temp:$temp, power:$power, minutes:$minutes, batteryStatus:$bstat}'
