#!/usr/bin/env bash
# Dalbit OS: 노트북 전원 상태에 따라 AMD 화면 절전(ABM) 조절
# - 충전기 연결: 0 (끔, 색상 정확도 우선)
# - 배터리:      2 (중간, 배터리 시간 우선)
# 배터리가 없는 기기(데스크톱)에서는 아무것도 하지 않습니다.

shopt -s nullglob

has_battery=0
on_ac=0
for ps in /sys/class/power_supply/*; do
    type=$(cat "$ps/type" 2>/dev/null)
    case "$type" in
        Battery) has_battery=1 ;;
        Mains|USB|USB_C|USB_PD)
            [ "$(cat "$ps/online" 2>/dev/null)" = "1" ] && on_ac=1 ;;
    esac
done

[ "$has_battery" = 1 ] || exit 0

level=2
[ "$on_ac" = 1 ] && level=0

for f in /sys/class/drm/card*-eDP-*/amdgpu/panel_power_savings; do
    # 배터리 상태에서 이미 더 강한 절전(강력 절전 모드 등)이 걸려 있으면 유지
    if [ "$on_ac" = 0 ] && [ "$(cat "$f" 2>/dev/null || echo 0)" -gt "$level" ]; then
        continue
    fi
    echo "$level" > "$f" 2>/dev/null || true
done
exit 0
