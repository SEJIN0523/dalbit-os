<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Dalbit OS: 노트북 앞에 앉아 있는 사용자(활성 세션)는 비밀번호 없이 배터리 보호를 켜고 끌 수 있음.
     원격(SSH) 등 비활성 세션은 관리자 인증 필요. 허용 대상은 battery-set 하나뿐. -->
<policyconfig>
  <vendor>Dalbit OS</vendor>
  <vendor_url>https://github.com/SEJIN0523/dalbit-os</vendor_url>
  <action id="org.dalbit.battery.set">
    <description>Change battery conservation mode</description>
    <description xml:lang="ko">배터리 보호 모드 변경</description>
    <message>Authentication is required to change battery conservation mode</message>
    <message xml:lang="ko">배터리 보호 모드를 바꾸려면 인증이 필요합니다</message>
    <icon_name>dalbit</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/dalbit/battery-set</annotate>
  </action>
</policyconfig>
