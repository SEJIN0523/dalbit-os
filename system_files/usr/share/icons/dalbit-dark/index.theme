[Icon Theme]
Name=Dalbit Dark
Comment=Dalbit OS folder icons (F1 flat) and start button
Inherits=breeze-dark,breeze,hicolor
Directories=places/scalable,apps/scalable

[places/scalable]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[apps/scalable]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications
