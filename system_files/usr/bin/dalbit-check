#!/usr/bin/env bash
# Dalbit OS 최적화 상태 점검
shopt -s nullglob

ok()   { printf '  \e[32m✔\e[0m %-22s %s\n' "$1" "$2"; }
warn() { printf '  \e[33m!\e[0m %-22s %s\n' "$1" "$2"; }

echo "🌙 Dalbit OS 상태 점검"
echo

echo "[시스템]"
# rpm-ostree status는 관리자 권한 없이도 동작 (bootc status는 root 필요)
img=$(rpm-ostree status --json 2>/dev/null | jq -r '.deployments[] | select(.booted) | ."container-image-reference" // empty')
case "$img" in
    ostree-image-signed:*) ok "이미지" "${img#*docker://} (서명 검사 켜짐)" ;;
    "") warn "이미지" "알 수 없음 — rpm-ostree status 확인" ;;
    *) warn "이미지" "${img#*docker://} (서명 검사 꺼짐)" ;;
esac
ok "커널" "$(uname -r)"
ok "CPU" "$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)"
mem_gb=$(awk '/MemTotal/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
ok "메모리 (OS 인식)" "${mem_gb} GB"
echo

echo "[CPU]"
sched=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null)
if [ -n "$sched" ]; then ok "스케줄러" "$sched (sched_ext)"; else ok "스케줄러" "기본 (EEVDF)"; fi
pstate=$(cat /sys/devices/system/cpu/amd_pstate/status 2>/dev/null)
if [ "$pstate" = "active" ]; then ok "amd-pstate" "active (EPP)"; else warn "amd-pstate" "${pstate:-없음} — BIOS에서 CPPC 활성화 확인"; fi
ok "EPP" "$(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo 없음)"
# Dalbit은 tuned-ppd 사용 (powerprofilesctl 없음)
profile=$(tuned-adm active 2>/dev/null | sed -n 's/^Current active profile: //p')
if [ -n "$profile" ]; then ok "전원 프로필" "$profile"; else warn "전원 프로필" "알 수 없음 — systemctl status tuned 확인"; fi
echo

echo "[메모리]"
zram=$(swapon --show=NAME,SIZE --noheadings 2>/dev/null | grep zram)
if [ -n "$zram" ]; then ok "zram" "$zram"; else warn "zram" "비활성"; fi
ok "swappiness" "$(cat /proc/sys/vm/swappiness)"
echo

echo "[GPU / 영상]"
for c in /sys/class/drm/card*/device; do
    [ -r "$c/mem_info_vram_total" ] || continue
    vram=$(( $(cat "$c/mem_info_vram_total") / 1024 / 1024 ))
    gtt=$(( $(cat "$c/mem_info_gtt_total") / 1024 / 1024 ))
    ok "GPU 메모리" "전용 ${vram} MB + 공유(GTT) ${gtt} MB"
done
if command -v vainfo >/dev/null; then
    codecs=$(vainfo 2>/dev/null | grep -oE 'VAProfile(H264|HEVC|VP9|AV1)[A-Za-z0-9]*' | sed 's/VAProfile//' | sort -u | tr '\n' ' ')
    if [ -n "$codecs" ]; then ok "하드웨어 디코딩" "$codecs"; else warn "하드웨어 디코딩" "VA-API 응답 없음"; fi
fi
echo

echo "[NPU]"
if [ -e /dev/accel/accel0 ]; then ok "Ryzen AI NPU" "인식됨 (/dev/accel/accel0)"; else warn "Ryzen AI NPU" "인식 안 됨 (BIOS에서 IPU/NPU 활성화 확인)"; fi

bat=(/sys/class/power_supply/BAT*)
if [ ${#bat[@]} -gt 0 ]; then
    echo
    echo "[노트북]"
    ok "배터리" "$(cat "${bat[0]}/capacity")% ($(cat "${bat[0]}/status"))"
    ok "배터리 보호" "$(dalbit-battery 2>/dev/null | head -1 | sed 's/.*: //')"
fi
