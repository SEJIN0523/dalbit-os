#!/usr/bin/env bash
# Dalbit OS 기본 앱 설치 (Flatpak)
#   dalbit-setup          지금 바로 설치 (터미널에서 진행 상황 표시)
#   dalbit-setup --auto   로그인할 때 자동 실행용: 앱 목록이 바뀌었을 때만 동작, 알림으로 진행 상황 표시
# 이미 설치된 앱은 건너뛰고, 목록에서 빠진 앱을 지우지는 않습니다.
set -euo pipefail

LIST=/usr/share/dalbit/flatpaks.list
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dalbit"
STAMP="$STATE_DIR/flatpaks.sha256"
AUTO=0
[ "${1:-}" = "--auto" ] && AUTO=1

notify() {
    if [ "$AUTO" = 1 ] && command -v notify-send >/dev/null; then
        notify-send --app-name="Dalbit OS" --icon=dalbit "$1" "${2:-}" || true
    fi
    echo "$1 ${2:-}"
}

mkdir -p "$STATE_DIR"
LIST_HASH=$(sha256sum "$LIST" | cut -d' ' -f1)
if [ "$AUTO" = 1 ] && [ "$(cat "$STAMP" 2>/dev/null)" = "$LIST_HASH" ]; then
    exit 0   # 목록이 그대로면 아무것도 하지 않음
fi

flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo

mapfile -t APPS < <(grep -vE '^\s*(#|$)' "$LIST")
MISSING=()
for app in "${APPS[@]}"; do
    flatpak info "$app" >/dev/null 2>&1 || MISSING+=("$app")
done

if (( ${#MISSING[@]} )); then
    # 자동 실행인데 인터넷이 없으면 다음 로그인 때 다시 시도
    if [ "$AUTO" = 1 ] && ! flatpak remote-ls --user flathub --columns=application >/dev/null 2>&1; then
        exit 0
    fi
    notify "🌙 기본 앱을 설치하고 있습니다" "${#MISSING[@]}개 앱 · 몇 분 걸릴 수 있습니다"
    flatpak install --user -y --noninteractive flathub "${MISSING[@]}"
fi

# Chrome(Wayland)에서 fcitx5 한글 입력 활성화
CHROME_FLAGS="$HOME/.var/app/com.google.Chrome/config/chrome-flags.conf"
mkdir -p "$(dirname "$CHROME_FLAGS")"
for flag in --enable-wayland-ime --wayland-text-input-version=3; do
    grep -qxF -- "$flag" "$CHROME_FLAGS" 2>/dev/null || echo "$flag" >> "$CHROME_FLAGS"
done

echo "$LIST_HASH" > "$STAMP"
if (( ${#MISSING[@]} )); then
    notify "✅ 기본 앱 설치 완료" "${#MISSING[@]}개 앱을 설치했습니다"
else
    [ "$AUTO" = 1 ] || echo "✅ 기본 앱이 모두 설치되어 있습니다."
fi
